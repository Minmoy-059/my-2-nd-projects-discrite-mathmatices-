#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <sys/time.h>

#define EDGE_PROBABILITY 0.01 // Adjust to keep edge count manageable

void generateGraph(int n, int **adjMatrix) {
    for (int i = 0; i < n; i++)
        for (int j = i + 1; j < n; j++) {
            if (((double) rand() / RAND_MAX) < EDGE_PROBABILITY) {
                adjMatrix[i][j] = 1;
                adjMatrix[j][i] = 1;
            }
        }
}

int countEdgesAndDegrees(int n, int **adjMatrix, int *degrees) {
    int edgeCount = 0;

    for (int i = 0; i < n; i++) {
        degrees[i] = 0;
        for (int j = 0; j < n; j++) {
            degrees[i] += adjMatrix[i][j];
            if (j > i && adjMatrix[i][j]) {
                edgeCount++;
            }
        }
    }
    return edgeCount;
}

int main() {
    int sizes[] = {1000, 2000, 3000, 4000, 5000};

    printf("n,edges,time_ms\n");

    for (int k = 0; k < 5; k++) {
        int n = sizes[k];

        // Allocate memory
        int **adjMatrix = (int **) malloc(n * sizeof(int *));
        int *degrees = (int *) malloc(n * sizeof(int));
        for (int i = 0; i < n; i++)
            adjMatrix[i] = (int *) calloc(n, sizeof(int));

        srand(time(NULL));

        struct timeval start, end;
        gettimeofday(&start, NULL);

        generateGraph(n, adjMatrix);
        int edgeCount = countEdgesAndDegrees(n, adjMatrix, degrees);

        gettimeofday(&end, NULL);
        double elapsed = (end.tv_sec - start.tv_sec) * 1000.0;
        elapsed += (end.tv_usec - start.tv_usec) / 1000.0;

        long long degreeSum = 0;
        for (int i = 0; i < n; i++)
            degreeSum += degrees[i];

        if (degreeSum != 2LL * edgeCount)
            printf("Handshaking lemma failed for n = %d\n", n);

        printf("%d,%d,%.2f\n", n, edgeCount, elapsed);

        // Free memory
        for (int i = 0; i < n; i++)
            free(adjMatrix[i]);wqqqqew
        free(adjMatrix);
        free(degrees);
    }

    return 0;
}

